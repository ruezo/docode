{
  "name": "docode",
  "version": "0.0.5",
  "private": true,
  "description": "Your forum, now with a minimap.",
  "license": "MIT",
  "author": "ruez",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "format": "prettier --write package.json tsconfig.json wxt.config.ts eslint.config.js prettier.config.js vitest.config.ts \"entrypoints/**/*.{html,css,ts,tsx}\" \"src/**/*.{css,ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check package.json tsconfig.json wxt.config.ts eslint.config.js prettier.config.js vitest.config.ts \"entrypoints/**/*.{html,css,ts,tsx}\" \"src/**/*.{css,ts,tsx}\" \"scripts/**/*.{mjs,ts}\" \"tests/**/*.{ts,tsx}\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "audit:security": "node scripts/audit-security.mjs chrome",
    "audit:security:firefox": "node scripts/audit-security.mjs firefox",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:package:firefox": "node scripts/verify-firefox-package.mjs",
    "verify:content-context": "node scripts/verify-content-context-recovery.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run build:firefox && npm run audit:security && npm run audit:security:firefox"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "@wxt-dev/browser": "0.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "rollup": "4.62.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
